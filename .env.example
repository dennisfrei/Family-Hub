# --- Database (PostgreSQL) --------------------------------------------------
# Used by the compose database container and to build the URLs below.
POSTGRES_USER=family_hub
POSTGRES_PASSWORD=family_hub
POSTGRES_DB=family_hub
# The app on the host (`make run`); inside compose the host is replaced by `db`.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Integration tests; default: DATABASE_URL with the database name + `_test`.
# TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}_test
# Apply migrations on start.
# RUN_MIGRATIONS=true

# --- Server -----------------------------------------------------------------
# HOST=0.0.0.0
PORT=8080
# LOG_LEVEL=INFO
# Time zone for display and for interpreting times entered without zone.
# TIMEZONE=Europe/Berlin
# Path prefix of a proxy that strips it without sending X-Forwarded-Prefix, e.g. code-server: /proxy/8080
FORWARDED_PREFIX=
# Signs browser storage and the login cookies; long random value, e.g. `openssl rand -hex 32`.
STORAGE_SECRET=change-me-to-a-long-random-value

# --- API tokens ---------------------------------------------------------------
# Signing key for API tokens, at least 32 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-at-least-32-random-characters

# --- Login via OIDC, e.g. Pocket ID (README: "Login (OIDC)") -------------------
AUTH_ENABLED=false
# External URL of the app incl. any path prefix; needed when AUTH_ENABLED=true.
# PUBLIC_URL=http://localhost:8080
# OIDC_ISSUER=http://localhost:1411
# OIDC_CLIENT_ID=
# Without a secret a public client with PKCE is used.
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email groups
# Comma-separated group names; empty: everyone may sign in / every signed-in user is admin.
# OIDC_ALLOWED_GROUPS=family
# OIDC_ADMIN_GROUPS=parents
# AUTH_SESSION_DAYS=14

# --- Backups (S3-compatible storage) ---------------------------------------------
# Local RustFS from docker compose; inside compose the host is replaced by `s3`. Its credentials are the two below.
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=family-hub
AWS_SECRET_ACCESS_KEY=family-hub-secret
AWS_REGION=us-east-1
BACKUP_BUCKET=family-hub-backups
# BACKUP_PREFIX=family-hub/
# Local backups and the hash of the last upload.
# BACKUP_DIR=backups

# --- Growth ---------------------------------------------------------------------
# Directory with the reference tables (not part of the repository, see README).
GROWTH_REFERENCE_DIR=data/private/growth-reference
# Source of the reference data, printed in growth reports.
# GROWTH_REFERENCE_NAME=

# --- Fever thresholds in °C (infant < 3 months, child < 12 years, adult) -----------
# FEVER_THRESHOLD_INFANT=38.0
# ELEVATED_THRESHOLD_INFANT=37.5
# FEVER_THRESHOLD_CHILD=38.5
# ELEVATED_THRESHOLD_CHILD=37.5
# FEVER_THRESHOLD_ADULT=38.2
# ELEVATED_THRESHOLD_ADULT=37.5

# --- Image (Makefile) -------------------------------------------------------------
# Registry for `make push` / `make release`, e.g. registry.example.org/family
# REGISTRY=
# IMAGE_NAME=family-hub
# TAG defaults to the short git commit; PLATFORM e.g. linux/amd64
# TAG=
# PLATFORM=
